# ============================================================
# 仓库根级忽略规则（AI掘金头条：toutiao_backend + xwzx-news）
# ------------------------------------------------------------
# 各子目录还有自己的 .gitignore，这里是兜底 + 屏蔽本机环境产物。
# 上公开仓库前务必确认：私密配置、依赖目录、构建产物都没进来。
# ============================================================

# ---------- 私密配置（最重要）----------
# 里面有数据库密码和大模型 API Key
.env
.env.local
.env.*.local

# ---------- 本机 AI 助手的工作数据 ----------
# .workbuddy/ 是 WorkBuddy 的项目记忆与运行数据，.claude/ 同理，
# 属于本机工作痕迹，不属于项目源码。
.workbuddy/
.claude/

# ---------- 本机工具配置 ----------
# MCP 服务器地址、MCP 配置等，只对当前这台机器有效
.mcp.json
.mcp.local.json

# ---------- Python 产物 ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ---------- Node 产物 ----------
node_modules/
dist/
dist-ssr/
.vite/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 运行日志 ----------
logs/
*.log

# ---------- 系统杂项 ----------
.DS_Store
Thumbs.db
