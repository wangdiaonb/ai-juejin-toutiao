# 【最重要】私密配置：里面有数据库密码和大模型 API Key
.env

# Python 运行产物
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# IDE / 编辑器
.idea/
.vscode/
*.swp

# 系统和编辑器杂项
.DS_Store
Thumbs.db

# 运行日志与计划任务的互斥锁
# logs/scheduled_fetch.log 是 Windows 任务计划跑采集时的输出，
# 属于本机运行产物，不该进版本库
logs/
