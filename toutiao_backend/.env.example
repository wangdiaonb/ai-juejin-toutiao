# ============================================================
# 环境变量配置模板
# ------------------------------------------------------------
# 用法：把本文件复制一份并重命名为 .env，然后填入你自己的值。
#      （即把 .env.example 改成 .env，文件名里不要留 .example）
#
# ⚠️ .env 里放的是数据库密码和私密密钥，不要提交到 git、不要发给别人。
#    项目根的 .gitignore 与 toutiao_backend/.gitignore 都已忽略 .env。
# ============================================================

# ---------- 数据库连接串（必需，不配置服务会直接启动失败）----------
# 格式：mysql+aiomysql://用户名:密码@主机:端口/库名?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://root:你的数据库密码@localhost:3306/news_app?charset=utf8mb4

# ---------- 大模型（可选）----------
# 不配置也能跑：AI 新闻采集照样工作，只是走「原文摘录」模式 ——
# 一字不改地摘原文标题和正文，不调用大模型，零编造风险。
# 想改成大模型改写，把 config/fetcher_conf.py 里的 USE_LLM_REWRITE 打开即可。

# ---------- 接口地址（OpenAI 兼容协议，换厂商只改这里和模型名）----------
# DeepSeek      https://api.deepseek.com/v1                       模型 deepseek-chat
# 阿里通义百炼   https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# 智谱 GLM      https://open.bigmodel.cn/api/paas/v4               模型 glm-4-flash
# 月之暗面 Kimi  https://api.moonshot.cn/v1                        模型 moonshot-v1-8k
# 硅基流动      https://api.siliconflow.cn/v1                     模型 Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=https://api.deepseek.com/v1

# ---------- 你的 API Key（留空 = 降级为原文截取）----------
LLM_API_KEY=

# ---------- 模型名 ----------
LLM_MODEL=deepseek-chat

# ---------- 单次调用超时（秒）----------
LLM_TIMEOUT=60

# ---------- 采样温度：摘要任务要稳，给低值 ----------
LLM_TEMPERATURE=0.3
